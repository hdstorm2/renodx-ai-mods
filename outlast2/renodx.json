{
  "$schema": "https://cdn.jsdelivr.net/gh/clshortfuse/renodx/renodx-metadata-schema.json",
  "id": "outlast2-hdr",
  "title": "Outlast 2",
  "variant": "HDR",
  "maintainers": ["hdstorm2"],
  "support": "bespoke",
  "summary": "HDR upgrade for Outlast 2 with improved tone mapping and hue preservation",
  "tags": ["HDR", "Tone Mapping"],
  "status": "experimental",
  "version": "1.0.0",
  "urls": [
    {
      "url": "https://github.com/hdstorm2/renodx-ai-mods",
      "kind": "repository"
    }
  ],
  "games": [
    {
      "title": "Outlast 2",
      "aliases": ["Outlast II"],
      "support": "bespoke",
      "status": "experimental"
    }
  ],
  "deploy": {
    "reshade_version_range": ">=5.9.0",
    "reshade_preferred_name": "dxgi.dll",
    "game_exe": "Outlast2.exe",
    "process_name": "Outlast2.exe",
    "api": "d3d11",
    "hook": ["dxgi.dll"],
    "steam_appid": 414700,
    "architecture": ["x64"],
    "detection": {
      "default_install_paths": [
        "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Outlast 2",
        "C:\\Program Files\\Steam\\steamapps\\common\\Outlast 2"
      ],
      "probe_process_by_name": true
    },
    "installer": {
      "requires_admin": false,
      "backup": true,
      "targets": [
        {
          "source": "renodx-outlast2-hdr.addon64",
          "destination": ".",
          "mode": "copy"
        }
      ]
    }
  }
}
